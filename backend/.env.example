# ===========================================
# HiveMQ Cloud MQTT Configuration
# ===========================================
# Replace these with your actual HiveMQ Cloud credentials
# Get them from: https://console.hivemq.cloud/

MQTT_BROKER=your-cluster-id.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# ===========================================
# Flask Server Configuration
# ===========================================
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True
SECRET_KEY=change-this-to-a-random-secret-key

# ===========================================
# Database
# ===========================================
DATABASE_PATH=data/bus_tracking.db

# ===========================================
# Google Maps API Configuration
# ===========================================
# Get your API key from: https://console.cloud.google.com/
# Enable: Directions API, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
